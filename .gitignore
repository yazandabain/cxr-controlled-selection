# Only reviewed public paths are eligible for tracking.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/NOTICE.md
!/CITATION.cff
!/pyproject.toml
!/src/
!/tests/
!/examples/
!/docs/
!/scripts/
!/.github/
!/results/
!/figures/
!/THIRD_PARTY.md
!/third_party/

# Source-only boundary; generated outputs and local configuration stay private.
**/__pycache__/
**/*.pyc
**/*.egg-info/
**/.venv/
**/.env*
**/*.csv
**/*.tsv
**/*.parquet
**/*.arrow
**/*.feather
**/*.npy
**/*.npz
**/*.pkl
**/*.pickle
**/*.joblib
**/*.pt
**/*.pth
**/*.ckpt
**/*.safetensors
**/*.ubj
**/*.dcm
**/*.jpg
**/*.jpeg
**/*.png
**/*.pdf
**/*.tex
**/*.bib
**/*.zip
**/*.log
**/*manifest*
**/*private*

# Only the reviewed presentation exports override the data/binary exclusions.
!/results/tables/*.csv
!/figures/figure1_design.pdf
!/figures/figure2_selection.pdf
!/figures/figure3_learning_curves.pdf
!/figures/figure4_controlled_contrasts.pdf
!/figures/figure5_era.pdf
!/figures/figure7_selection_controls.pdf
!/figures/figure8_pair_accounting.pdf
!/figures/figureS1_reference_transfer.pdf
